+
+/* Account screen — sign in / create account, and the "synced" status
+   badge shown once an account is active. */
+
+.segmented {
+  display: inline-flex;
+  padding: 4px;
+  background: var(--surface-hover);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-full);
+  gap: 2px;
+  margin-bottom: var(--space-5);
+}
+
+.segmented-btn {
+  padding: var(--space-2) var(--space-5);
+  border-radius: var(--radius-full);
+  font-family: var(--font-body);
+  font-size: var(--text-sm);
+  font-weight: 600;
+  color: var(--ink-muted);
+  background: transparent;
+  border: none;
+  cursor: pointer;
+  transition: background-color 0.15s ease, color 0.15s ease;
+}
+
+.segmented-btn[data-active='true'] {
+  background: var(--surface);
+  color: var(--ink);
+  box-shadow: var(--shadow-sm);
+}
+
+.segmented-btn:hover:not([data-active='true']) {
+  color: var(--ink);
+}
+
+.account-form .btn {
+  width: 100%;
+  margin-top: var(--space-2);
+}
+
+.sync-badge {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-2);
+  font-size: var(--text-sm);
+  font-weight: 500;
+  padding: var(--space-2) var(--space-4);
+  border-radius: var(--radius-full);
+  background: var(--surface-hover);
+  color: var(--ink-muted);
+  margin: 0 0 var(--space-4);
+}
+
+.sync-dot {
+  width: 8px;
+  height: 8px;
+  border-radius: 50%;
+  background: var(--ink-muted);
+  flex-shrink: 0;
+}
+
+.sync-badge[data-status='live'] {
+  color: var(--teal-hover);
+}
+
+.sync-badge[data-status='live'] .sync-dot {
+  background: var(--teal);
+  box-shadow: 0 0 0 3px rgba(30, 158, 140, 0.18);
+}
+
+.sync-badge[data-status='connecting'] .sync-dot {
+  background: var(--gold);
+  animation: sync-pulse 1.2s ease-in-out infinite;
+}
+
+.sync-badge[data-status='error'] {
+  color: var(--danger);
+  background: var(--danger-surface);
+}
+
+.sync-badge[data-status='error'] .sync-dot {
+  background: var(--danger);
+}
+
+@keyframes sync-pulse {
+  0%, 100% {
+    opacity: 1;
+  }
+  50% {
+    opacity: 0.4;
+  }
+}
-- 
