# From your Firebase project's Web app config (Project settings > General
# > Your apps). Only VITE_FIREBASE_API_KEY and VITE_FIREBASE_PROJECT_ID are
# required for sharing to work; the rest are included for completeness.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
